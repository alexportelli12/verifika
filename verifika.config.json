{
  "$schema": "./schemas/verifika.schema.json",
  "version": 1,
  "defaults": {
    "concurrency": 4,
    "timeoutMs": 600000
  },
  "changes": {
    "invalidateAll": ["package.json", "package-lock.json", "tsconfig*.json"]
  },
  "checks": {
    "format": {
      "command": "npm run format:check"
    },
    "lint": {
      "command": "npm run lint",
      "paths": ["**/*.{ts,js,mjs}", "eslint.config.js"]
    },
    "typecheck": {
      "command": "npm run typecheck",
      "paths": ["src/**", "test/**", "vitest.config.ts"]
    },
    "build": {
      "command": "npm run build",
      "paths": ["src/**"]
    },
    "test": {
      "command": "npm test",
      "paths": ["src/**", "test/**", "schemas/**", "examples/**", "vitest.config.ts"],
      "dependsOn": ["build"]
    },
    "skill": {
      "command": "npm run check:skill",
      "paths": ["skills/**", "scripts/check-skill.mjs", "src/**"]
    },
    "pack": {
      "command": "npm run test:pack",
      "paths": ["src/**", "schemas/**", "skills/**", "scripts/pack-smoke.mjs", "README.md"],
      "dependsOn": ["build"]
    },
    "docs": {
      "command": "npm run check:docs",
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "docs/**",
        "examples/**",
        "schemas/**",
        "skills/verifika/**",
        "site/**",
        "src/main.ts",
        "src/errors.ts",
        "scripts/docs/**",
        "package.json"
      ]
    },
    "docs-tests": {
      "command": "npm run test:docs",
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "docs/**",
        "examples/**",
        "schemas/**",
        "skills/verifika/**",
        "site/index.html",
        "src/main.ts",
        "src/errors.ts",
        "scripts/docs/**"
      ]
    },
    "docs-fresh": {
      "command": "npm run check:docs-fresh",
      "paths": [
        "README.md",
        "docs/**",
        "site/index.html",
        "src/**",
        "schemas/**",
        "skills/verifika/**",
        "scripts/check-skill.mjs",
        "scripts/docs/**"
      ]
    },
    "prose": {
      "command": "npm run --silent prose",
      "paths": [
        "README.md",
        "docs/**",
        "site/index.html",
        ".vale.ini",
        ".vale/**",
        "scripts/docs/vale.mjs"
      ]
    }
  }
}
