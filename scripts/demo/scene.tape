# The demo scene shared by wide.tape and narrow.tape, which set the output
# files and terminal size. Recorded with VHS (https://github.com/charmbracelet/vhs)
# by record.sh.

Set Shell bash
Set FontFamily "JetBrains Mono"
Set LineHeight 1.35
Set Margin 0
Set WindowBar ""
Set BorderRadius 0
Set Framerate 30
Set TypingSpeed 75ms
Set CursorBlink false
Set Theme { "name": "verifika", "background": "#0e1013", "foreground": "#d9dde3", "cursor": "#7ee2a8", "selection": "#2a3038", "black": "#0e1013", "brightBlack": "#5b636e", "red": "#f2777a", "brightRed": "#f2777a", "green": "#7ee2a8", "brightGreen": "#7ee2a8", "yellow": "#e8c46f", "brightYellow": "#e8c46f", "blue": "#7fb4f0", "brightBlue": "#7fb4f0", "magenta": "#c49ce8", "brightMagenta": "#c49ce8", "cyan": "#74d3d6", "brightCyan": "#74d3d6", "white": "#d9dde3", "brightWhite": "#ffffff" }

Hide
Type "source /vhs/scripts/demo/setup.sh" Enter
Sleep 9s
Show

Sleep 600ms
Type "vfk"
Sleep 400ms
Enter
Sleep 11s
