{
  "$schema": "../schemas/verifika.schema.json",
  "version": 1,
  "defaults": {
    "concurrency": 2
  },
  "changes": {
    "invalidateAll": ["package.json", "package-lock.json", "nx.json", "tsconfig*.json"]
  },
  "checks": {
    "format": { "command": "npx nx format:check" },
    "lint": {
      "command": "npx nx affected -t lint --base=origin/main",
      "paths": ["apps/**", "libs/**"]
    },
    "test": {
      "command": "npx nx affected -t test --base=origin/main",
      "paths": ["apps/**", "libs/**"]
    },
    "build": {
      "command": "npx nx affected -t build --base=origin/main",
      "paths": ["apps/**", "libs/**"]
    }
  }
}
